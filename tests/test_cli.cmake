string(RANDOM LENGTH 12 suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/laminar-cli-${suffix}")
file(MAKE_DIRECTORY "${root}")
set(db "${root}/db")

function(check expected_code expected_output)
  execute_process(COMMAND "${CLI}" ${ARGN}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${code}" STREQUAL "${expected_code}" OR
     NOT "${output}" STREQUAL "${expected_output}" OR
     (code EQUAL 0 AND NOT "${error}" STREQUAL "") OR
     (NOT code EQUAL 0 AND "${error}" STREQUAL ""))
    message(FATAL_ERROR "Command ${ARGN}: exit=${code}, stdout=[${output}], stderr=[${error}]. Fixture ${root}")
  endif()
endfunction()

check(2 "" inspect "${db}")
check(2 "" compact "${db}")
check(3 "" compact "${db}" extra)
check(3 "" put "${db}" 610 00ff)
check(3 "" put "${db}" "61  " 00ff)
check(3 "" put "${db}" 61 XX)
check(3 "" delete "${db}" 61 extra)
if(EXISTS "${db}")
  message(FATAL_ERROR "Inspect or invalid input created ${db}")
endif()

check(0 "" put "${db}" 6100 00FF)
check(0 "00ff\n" get "${db}" 6100)
# ARGN list expansion drops empty elements. Execute this case with literal empty arguments.
execute_process(COMMAND "${CLI}" put "${db}" "" ""
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT "${output}${error}" STREQUAL "")
  message(FATAL_ERROR "Empty put failed: ${code} [${output}] [${error}]")
endif()
execute_process(COMMAND "${CLI}" get "${db}" ""
  RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT "${output}" STREQUAL "\n" OR NOT "${error}" STREQUAL "")
  message(FATAL_ERROR "Empty get failed: ${code} [${output}] [${error}]")
endif()
check(0 "" delete "${db}" 6100)
check(2 "" get "${db}" 6100)

set(log "${db}/data.log")
file(APPEND "${log}" "L")
file(SHA256 "${log}" before)
file(SIZE "${log}" size)
check(0 "{\"format_version\":1,\"log_bytes\":${size},\"record_count\":3,\"live_keys\":1,\"incomplete_tail_bytes\":1}\n"
  inspect "${db}")
file(SHA256 "${log}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Inspect modified ${log}")
endif()

set(input "${root}/batch.txt")
check(3 "" batch "${db}")
check(1 "" batch "${db}" "${input}")
check(1 "" batch "${db}" "${root}")
foreach(invalid IN ITEMS
    "\n" "put\t61" "delete" "delete\t61\t" "put\t61\t\t" "get\t61"
    "put\t6\t00" "put\t61\txx" "put\t61\t  " "put\t61\t00\r")
  file(WRITE "${input}" "put\t61\t00\n${invalid}")
  check(3 "" batch "${db}" "${input}")
  check(3 "" batch "${root}/new" "${input}")
endforeach()
if(EXISTS "${root}/new")
  message(FATAL_ERROR "Invalid batch created a database")
endif()
string(REPEAT "delete\t\n" 1025 excessive_ops)
file(WRITE "${input}" "${excessive_ops}")
check(3 "" batch "${db}" "${input}")
string(REPEAT "00" 65537 excessive_key)
file(WRITE "${input}" "delete\t${excessive_key}\n")
check(3 "" batch "${db}" "${input}")
string(REPEAT "00" 8388608 max_value)
string(REPEAT "00" 8388591 second_value)
file(WRITE "${input}" "put\t\t${max_value}\nput\t\t${second_value}\n")
check(3 "" batch "${db}" "${input}")
unset(max_value)
unset(second_value)

math(EXPR max_input "2 * 16777216 + 65536")
string(REPEAT "0" ${max_input} invalid_line)
file(WRITE "${input}" "${invalid_line}")
unset(invalid_line)
foreach(diagnostic IN ITEMS "invalid batch line" "batch input size limit")
  execute_process(COMMAND "${CLI}" batch "${db}" "${input}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT code EQUAL 3 OR NOT "${output}" STREQUAL "" OR NOT error MATCHES "${diagnostic}")
    message(FATAL_ERROR "Batch size boundary failed: ${code} [${output}] [${error}]")
  endif()
  file(APPEND "${input}" "0")
endforeach()
file(SHA256 "${log}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Invalid batch modified ${log}, including its incomplete tail")
endif()

# Mix both newline styles, preserve an empty final field, and allow an unterminated last line.
file(WRITE "${input}" "put\t6100\t00FF\r\ndelete\t\r\nput\t62\tA1\nput\t6100\t\nput\t63\tBEEF")
check(0 "" batch "${db}" "${input}")
check(0 "\n" get "${db}" 6100)
check(0 "a1\n" get "${db}" 62)
check(0 "beef\n" get "${db}" 63)
file(SIZE "${log}" size)
check(0 "{\"format_version\":1,\"log_bytes\":${size},\"record_count\":4,\"live_keys\":3,\"incomplete_tail_bytes\":0}\n"
  inspect "${db}")
file(SHA256 "${log}" before)
file(WRITE "${input}" "")
check(0 "" batch "${db}" "${input}")
file(SHA256 "${log}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Empty batch modified ${log}")
endif()

check(0 "" compact "${db}")
check(0 "\n" get "${db}" 6100)
check(0 "a1\n" get "${db}" 62)
check(0 "beef\n" get "${db}" 63)
file(SIZE "${log}" size)
check(0 "{\"format_version\":1,\"log_bytes\":${size},\"record_count\":0,\"live_keys\":3,\"incomplete_tail_bytes\":0}\n"
  inspect "${db}")
file(APPEND "${log}" "L")
file(APPEND "${log}" "X")
file(SHA256 "${log}" before)
check(1 "" compact "${db}")
file(SHA256 "${log}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Compact modified corrupt source")
endif()
check(1 "" inspect "${db}")
file(REMOVE_RECURSE "${root}")
